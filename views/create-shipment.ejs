<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#1e40af" />
  <title>Create Shipment</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/responsive-improvements.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-bar">
      <a class="brand" href="/">
        <img src="/my-logo.png" alt="Logo" class="brand-logo" />
      </a>
      <nav>
        <a href="/">Home</a>
        <a href="/shipments/new" class="active">Create Shipment</a>
        <a href="/track-multiple">Track Multiple</a>
        <a href="/rates">Rates</a>
        <a href="/locations">Locations</a>
        <a href="/help">Help</a>
        <a href="/admin/shipments">Admin</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="card">
      <h2>Create a new shipment</h2>
      <% if (locals.error) { %>
        <div style="background: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 12px; border-radius: 8px; margin-bottom: 16px;">
          <%= error %>
        </div>
      <% } %>
      <form method="post" action="/shipments" class="grid grid-2">
        <h3>Sender Information</h3>
        <input name="senderName" placeholder="Full Name *" required />
        <input name="senderAddress" placeholder="Street Address *" required />
        <div class="grid grid-2" style="grid-column: 1 / -1; gap: 8px;">
          <input name="senderCity" placeholder="City *" required />
          <input name="senderState" placeholder="State *" required maxlength="2" style="text-transform: uppercase;" />
          <input name="senderZip" placeholder="ZIP Code *" required pattern="[0-9]{5}" maxlength="5" />
          <input name="senderPhone" type="tel" placeholder="Phone (555-555-5555)" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" />
        </div>
        <input name="originCity" type="hidden" value="" />

        <h3>Recipient Information</h3>
        <input name="recipientName" placeholder="Full Name *" required />
        <input name="recipientAddress" placeholder="Street Address *" required />
        <div class="grid grid-2" style="grid-column: 1 / -1; gap: 8px;">
          <input name="recipientCity" placeholder="City *" required />
          <input name="recipientState" placeholder="State *" required maxlength="2" style="text-transform: uppercase;" />
          <input name="recipientZip" placeholder="ZIP Code *" required pattern="[0-9]{5}" maxlength="5" />
          <input name="recipientPhone" type="tel" placeholder="Phone (555-555-5555)" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" />
        </div>
        <input name="destinationCity" type="hidden" value="" />

        <h3>Package Details</h3>
        <div style="grid-column: 1 / -1;">
          <label style="display: block; margin-bottom: 8px; font-weight: 600;">Package Type</label>
          <select name="packageType" required style="width: 100%;">
            <option value="">Select package type</option>
            <option value="letter">Letter / Large Envelope</option>
            <option value="flat-rate-envelope">Flat Rate Envelope</option>
            <option value="flat-rate-box-small">Small Flat Rate Box</option>
            <option value="flat-rate-box-medium">Medium Flat Rate Box</option>
            <option value="flat-rate-box-large">Large Flat Rate Box</option>
            <option value="package">Package / Thick Envelope</option>
            <option value="large-package">Large Package</option>
          </select>
        </div>
        
        <div class="grid grid-2" style="grid-column: 1 / -1; gap: 8px;">
          <div>
            <label style="display: block; margin-bottom: 4px; font-weight: 600;">Weight *</label>
            <div style="display: flex; gap: 4px;">
              <input name="weightLbs" type="number" min="0" max="70" placeholder="lbs" required style="flex: 1;" />
              <input name="weightOz" type="number" min="0" max="15" placeholder="oz" style="flex: 1;" />
            </div>
          </div>
          <input name="weightKg" type="hidden" value="0" />
          
          <div>
            <label style="display: block; margin-bottom: 4px; font-weight: 600;">Dimensions (inches)</label>
            <div style="display: flex; gap: 4px;">
              <input name="length" type="number" step="0.1" min="0" placeholder="L" />
              <input name="width" type="number" step="0.1" min="0" placeholder="W" />
              <input name="height" type="number" step="0.1" min="0" placeholder="H" />
            </div>
          </div>
        </div>

        <h3>Service Type</h3>
        <div style="grid-column: 1 / -1;">
          <select name="serviceType" required style="width: 100%;">
            <option value="">Select service type</option>
            <option value="priority-mail-express">Priority Mail Express (1-2 days)</option>
            <option value="priority-mail">Priority Mail (1-3 days)</option>
            <option value="first-class-mail">First-Class Mail (1-5 days)</option>
            <option value="retail-ground">SwiftTrack Ground (2-8 days)</option>
            <option value="media-mail">Media Mail (2-8 days)</option>
          </select>
        </div>

        <h3>Additional Services</h3>
        <div style="grid-column: 1 / -1;">
          <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <input type="checkbox" name="signatureConfirmation" value="true" />
            <span>Signature Confirmation (+$3.10)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <input type="checkbox" name="insurance" value="true" />
            <span>Insurance (up to $100, +$2.45)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <input type="checkbox" name="certifiedMail" value="true" />
            <span>Certified Mail (+$4.00)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <input type="checkbox" name="returnReceipt" value="true" />
            <span>Return Receipt (+$2.00)</span>
          </label>
        </div>

        <h3>Ship Date</h3>
        <div style="grid-column: 1 / -1;">
          <input name="shipDate" type="date" required style="width: 100%;" />
        </div>

        <div class="full-row" style="margin-top: 16px;">
          <button type="submit" style="width: 100%; padding: 14px; font-size: 16px;">Calculate Postage & Continue</button>
        </div>
      </form>
    </section>
  </main>

  <script>
    // Set min date to today
    const today = new Date().toISOString().split('T')[0];
    document.querySelector('input[name="shipDate"]').setAttribute('min', today);
    document.querySelector('input[name="shipDate"]').value = today;

    // Auto-populate hidden city fields from city inputs
    document.querySelector('form').addEventListener('submit', function(e) {
      const senderCity = document.querySelector('input[name="senderCity"]').value;
      const recipientCity = document.querySelector('input[name="recipientCity"]').value;
      document.querySelector('input[name="originCity"]').value = senderCity;
      document.querySelector('input[name="destinationCity"]').value = recipientCity;
      
      // Convert weight to kg for backend
      const lbs = parseFloat(document.querySelector('input[name="weightLbs"]').value) || 0;
      const oz = parseFloat(document.querySelector('input[name="weightOz"]').value) || 0;
      const totalLbs = lbs + (oz / 16);
      const kg = totalLbs * 0.453592;
      document.querySelector('input[name="weightKg"]').value = kg.toFixed(2);
    });

    // Format phone inputs
    document.querySelectorAll('input[type="tel"]').forEach(input => {
      input.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 0) {
          if (value.length <= 3) {
            e.target.value = value;
          } else if (value.length <= 6) {
            e.target.value = value.slice(0, 3) + '-' + value.slice(3);
          } else {
            e.target.value = value.slice(0, 3) + '-' + value.slice(3, 6) + '-' + value.slice(6, 10);
          }
        }
      });
    });
  </script>

  <footer class="site-footer">
    <div class="container">© 2026 Express Delivery Services. All Rights Reserved.</div>
  </footer>
</body>
</html>
