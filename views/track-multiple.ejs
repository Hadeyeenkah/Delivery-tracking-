<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Track Multiple Packages</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/usps-theme.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-bar">
      <a class="brand" href="/">
        <img src="/my-logo.png" alt="Logo" class="brand-logo" />
      </a>
      <nav>
        <a href="/">Home</a>
        <a href="/track">Track</a>
        <a href="/track-multiple" class="active">Multiple Tracking</a>
        <a href="/rates">Rates</a>
        <a href="/help">Help</a>
      </nav>
    </div>
  </header>

<main class="container">
  <!-- Page Header -->
  <section class="card" style="background: linear-gradient(135deg, #f0f4f8 0%, #ffffff 100%); border: 2px solid var(--accent); margin-bottom: 24px;">
    <h1 style="margin: 0 0 8px 0; color: var(--text); font-size: 28px;">Track Multiple Packages</h1>
    <p style="margin: 0; color: var(--muted); font-size: 15px;">Monitor the status of up to 10 shipments at once</p>
  </section>

  <!-- Input Form -->
  <section class="card">
    <h2 style="margin-top: 0;">Enter Tracking Numbers</h2>
    <form method="post" action="/track-multiple">
      <div style="margin-bottom: 16px;">
        <label style="display: block; margin-bottom: 8px; font-weight: 600; color: var(--text);">Tracking Numbers</label>
        <p style="margin: 0 0 12px 0; color: var(--muted); font-size: 14px;">Enter up to 10 tracking numbers (one per line or comma-separated)</p>
        <textarea 
          name="trackingNumbers" 
          rows="8" 
          placeholder="PT202601101234567890&#10;PT202601101234567891&#10;PT202601101234567892"
          required
          style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-family: 'Courier New', monospace; font-size: 14px; resize: vertical;"
        ></textarea>
      </div>
      <button type="submit" style="width: 100%; padding: 12px; background: var(--accent); color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 16px; cursor: pointer;">🔍 Track All Packages</button>
    </form>
  </section>

  <!-- Results -->
  <% if (typeof results !== 'undefined' && results && results.length > 0) { %>
    <section class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="margin: 0; font-size: 24px;">Tracking Results</h2>
        <span style="background: var(--accent); color: white; padding: 6px 14px; border-radius: 6px; font-weight: 600; font-size: 14px;"><%= results.length %> Package<%= results.length !== 1 ? 's' : '' %></span>
      </div>

      <!-- Summary Stats -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 24px;">
        <% 
          const stats = {
            total: results.length,
            found: results.filter(r => r.shipment).length,
            notFound: results.filter(r => !r.shipment).length,
            delivered: results.filter(r => r.shipment && r.shipment.currentStatus === 'Delivered').length,
            inTransit: results.filter(r => r.shipment && r.shipment.currentStatus !== 'Delivered' && r.shipment.currentStatus !== 'Delivery Failed').length,
            failed: results.filter(r => r.shipment && r.shipment.currentStatus === 'Delivery Failed').length
          };
        %>
        <div style="padding: 12px; background: #f9fafb; border-radius: 8px; border-left: 3px solid var(--accent);">
          <p style="margin: 0 0 4px 0; color: var(--muted); font-size: 12px; text-transform: uppercase; font-weight: 600;">Total Packages</p>
          <p style="margin: 0; font-size: 20px; font-weight: 700;"><%= stats.total %></p>
        </div>
        <div style="padding: 12px; background: #f9fafb; border-radius: 8px; border-left: 3px solid #059669;">
          <p style="margin: 0 0 4px 0; color: var(--muted); font-size: 12px; text-transform: uppercase; font-weight: 600;">Delivered</p>
          <p style="margin: 0; font-size: 20px; font-weight: 700; color: #059669;"><%= stats.delivered %></p>
        </div>
        <div style="padding: 12px; background: #f9fafb; border-radius: 8px; border-left: 3px solid #f59e0b;">
          <p style="margin: 0 0 4px 0; color: var(--muted); font-size: 12px; text-transform: uppercase; font-weight: 600;">In Transit</p>
          <p style="margin: 0; font-size: 20px; font-weight: 700; color: #f59e0b;"><%= stats.inTransit %></p>
        </div>
        <div style="padding: 12px; background: #f9fafb; border-radius: 8px; border-left: 3px solid var(--accent-red);">
          <p style="margin: 0 0 4px 0; color: var(--muted); font-size: 12px; text-transform: uppercase; font-weight: 600;">Failed/Issues</p>
          <p style="margin: 0; font-size: 20px; font-weight: 700; color: var(--accent-red);"><%= stats.failed %></p>
        </div>
      </div>

      <!-- Results List -->
      <div class="multi-track-results">
        <% results.forEach((result, idx) => { %>
          <div style="padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: #ffffff; margin-bottom: 12px;">
            <div style="display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: start;">
              <div style="text-align: center;">
                <span style="display: inline-block; width: 40px; height: 40px; background: var(--accent); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px;"><%= idx + 1 %></span>
              </div>

              <div style="min-width: 0;">
                <h4 style="margin: 0 0 8px 0; font-size: 14px; font-family: 'Courier New', monospace; word-break: break-all; color: var(--text);"><strong><%= result.trackingNumber %></strong></h4>
                <% if (result.shipment) { %>
                  <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 8px;">
                    <span class="status-badge status-<%= result.shipment.currentStatus.toLowerCase().replace(/\s+/g, '-') %>" style="font-size: 13px;">
                      <%= result.shipment.currentStatus %>
                    </span>
                    <% if (result.shipment.destinationCity) { %>
                      <span style="color: var(--muted); font-size: 13px;">📍 <%= result.shipment.destinationCity %></span>
                    <% } %>
                  </div>
                  <% if (result.shipment.estimatedDelivery && result.shipment.currentStatus !== 'Delivered') { %>
                    <p style="margin: 0; color: var(--muted); font-size: 13px;">📅 Est. Delivery: <strong><%= new Date(result.shipment.estimatedDelivery).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong></p>
                  <% } else if (result.shipment.currentStatus === 'Delivered') { %>
                    <p style="margin: 0; color: #059669; font-size: 13px;">✓ <strong>Delivered</strong></p>
                  <% } %>
                <% } else { %>
                  <p style="margin: 0; color: var(--accent-red); font-size: 13px; font-weight: 600;">⚠️ Not found in system</p>
                <% } %>
              </div>

              <a href="/track/<%= result.trackingNumber %>" style="padding: 8px 14px; background: var(--accent); color: white; text-decoration: none; border-radius: 6px; font-size: 13px; font-weight: 600; white-space: nowrap;">View Details →</a>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Summary Text -->
      <div style="margin-top: 24px; padding: 16px; background: #f9fafb; border-radius: 8px; border-left: 4px solid var(--accent);">
        <p style="margin: 0; color: var(--muted); font-size: 14px;">
          <strong>Summary:</strong> 
          <%= stats.found %> of <%= stats.total %> packages found. 
          <%= stats.delivered %> delivered, 
          <%= stats.inTransit %> in transit, 
          <%= stats.failed %> with delivery issues, 
          and <%= stats.notFound %> not found.
        </p>
      </div>
    </section>
  <% } else if (typeof results !== 'undefined' && results) { %>
    <!-- No Results -->
    <section class="card" style="text-align: center; padding: 40px 20px;">
      <h2 style="color: var(--muted);">No Results Found</h2>
      <p style="color: var(--muted); margin: 8px 0;">Please enter valid tracking numbers and try again.</p>
    </section>
  <% } %>
</main>

<footer class="site-footer">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; padding: 20px 0;">
      <div>
        <h4 style="margin: 0 0 8px 0; font-size: 14px; color: var(--accent); font-weight: 700;">Customer Service</h4>
        <p style="margin: 0; font-size: 13px;"><a href="/help" style="color: inherit; text-decoration: none;">Help & FAQ</a></p>
        <p style="margin: 4px 0 0 0; font-size: 13px;"><a href="/support" style="color: inherit; text-decoration: none;">Contact Us</a></p>
      </div>
      <div>
        <h4 style="margin: 0 0 8px 0; font-size: 14px; color: var(--accent); font-weight: 700;">Shipping</h4>
        <p style="margin: 0; font-size: 13px;"><a href="/shipments/new" style="color: inherit; text-decoration: none;">Create Shipment</a></p>
        <p style="margin: 4px 0 0 0; font-size: 13px;"><a href="/rates" style="color: inherit; text-decoration: none;">Rates & Services</a></p>
      </div>
      <div>
        <h4 style="margin: 0 0 8px 0; font-size: 14px; color: var(--accent); font-weight: 700;">Tracking</h4>
        <p style="margin: 0; font-size: 13px;"><a href="/track" style="color: inherit; text-decoration: none;">Track Package</a></p>
        <p style="margin: 4px 0 0 0; font-size: 13px;"><a href="/track-multiple" style="color: inherit; text-decoration: none;">Track Multiple</a></p>
      </div>
    </div>
    <hr style="border: none; border-top: 1px solid var(--border); margin: 20px 0; opacity: 0.5;" />
    <p style="margin: 0; text-align: center; font-size: 13px; color: var(--muted);">© 2026 Express Delivery Services. All Rights Reserved.</p>
  </div>
</footer>
</body>
</html>
